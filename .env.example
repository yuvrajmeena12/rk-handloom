# Copy to .env.local and fill in. Only the anon (public) key belongs in the browser.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Public site origin, used for canonical URLs and the sitemap (no trailing slash).
VITE_SITE_URL=https://your-domain.example
